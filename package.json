{
  "name": "puntito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "tsx scripts/local-dev.ts",
    "dev:lan": "tsx scripts/local-dev.ts --lan",
    "preview:lan": "pnpm build && tsx scripts/local-dev.ts --lan --production",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vercel": "64.7.0"
  }
}
